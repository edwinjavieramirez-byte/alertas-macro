mana_anterior":0.81,"sma20":92.6695,"sma50":90.875,"sma200":83.5944,"serie_tipo":"dias","serie":[91.48,93.03,96.05,102.48,100.05,101.39,105.83,102.43,101.91,100.3,95.78,94.59,92.16,94.61,92.41,92.6,89.38,90.42,92.87,91.11,89.43,89.44,88.28,91.49,91.85,93.24,94.78,94.02,97.6,97.33],"diario":[["2026-09-04",91.48],["2026-09-08",93.03],["2026-09-09",96.05],["2026-09-10",102.48],["2026-09-11",100.05],["2026-09-14",101.39],["2026-09-15",105.83],["2026-09-16",102.43],["2026-09-17",101.91],["2026-09-18",100.3],["2026-09-21",95.78],["2026-09-22",94.59],["2026-09-23",92.16],["2026-09-24",94.61],["2026-09-25",92.41],["2026-09-28",92.6],["2026-09-29",89.38],["2026-09-30",90.42],["2026-10-01",92.87],["2026-10-02",91.11],["2026-10-05",89.43],["2026-10-06",89.44],["2026-10-07",88.28],["2026-10-08",91.49],["2026-10-09",91.85],["2026-10-12",93.24],["2026-10-13",94.78],["2026-10-14",94.02],["2026-10-15",97.6],["2026-10-16",97.33]]},"DIF_US_DE":{"nombre":"Diferencial 10A EE. UU.-Alemania","grupo":"tipos","tipo":"pb","ultimo":167.3,"cambio_semana":-8.5,"serie":[144.6,144.7,139.9,144.8,147.2,142.9,146.0,149.3,146.8,147.4,151.0,151.4,156.6,155.1,155.6,159.6,164.1,171.4,171.5,182.2,182.0,178.9,179.6,173.9,175.8,177.4,175.4,166.5,167.4,167.3]},"PENDIENTE":{"nombre":"Pendiente 2A-10A EE. UU.","grupo":"tipos","tipo":"pb","ultimo":36.4}},"narrativa":{"semana_anterior":{"titular":"Dólar en máximos de 17 meses, rentabilidades récord y bolsa casi en máximos","resumen":"<cite index=\"47-2,47-3\">El dólar subió por cuarta semana seguida y el euro cayó a mínimos de 17 meses</cite>. <cite index=\"43-6\">El 10 años de EE. UU. tocó máximos de 24 años (5,365 %)</cite> por inflación, petróleo y dudas fiscales. <cite index=\"43-10\">El empleo de septiembre decepcionó (29.000 nóminas)</cite>, pero las actas de la Fed mantuvieron el sesgo de subida de tipos. <cite index=\"43-7\">Las subastas de deuda bien recibidas frenaron el repunte de rendimientos</cite>. <cite index=\"3-6\">El S&P 500 subió un 1,2 % en la semana</cite>, con un jueves flojo en tecnología.","claves":[{"titulo":"Empleo EE. UU. de septiembre","detalle":"<cite index=\"39-16\">Nóminas +29.000 (previsto ~90.000), paro 4,2 %, salarios +3,0 % anual.</cite> Rebajó algo las apuestas de subida en octubre; el dólar apenas cedió."},{"titulo":"Actas de la Fed","detalle":"<cite index=\"44-9\">La mayoría espera otra subida este año, con el momento incierto.</cite> Sostiene al dólar y a los rendimientos largos; presiona a la tecnología."},{"titulo":"Subastas del Tesoro (10 y 30 años)","detalle":"<cite index=\"42-14\">La subasta a 10 años salió 1,7 pb por debajo del mercado previo.</cite> Marcó techo temporal a los rendimientos y ayudó a la renta variable."},{"titulo":"Petróleo e Irán","detalle":"<cite index=\"44-6\">Trump dijo que no atacará Irán antes de las elecciones de mitad de mandato.</cite> Alivió algo el crudo y el VIX, pero el WTI sigue cerca de 94 dólares."},{"titulo":"Tecnología e inicio de resultados","detalle":"<cite index=\"2-5\">El jueves cayó la tecnología por informes de menores ingresos de OpenAI.</cite> <cite index=\"3-8\">Delta recortó previsiones por el combustible.</cite> El Nasdaq quedó rezagado."}]},"tesis":{"titular":"El IPC del miércoles decide si la Fed vuelve a subir tipos en octubre","texto":"La semana gira en torno al IPC de septiembre (miércoles 14:30), el último antes de la Fed del 28 de octubre. Se espera un 0,6 % mensual y un 3,6 % anual, con la inflación subiendo por la energía. Un dato más alto reactivaría las apuestas de subida y empujaría al dólar y a los rendimientos largos, que siguen cerca de máximos de 24 años. Un dato más suave aliviaría a la tecnología. Los resultados de los grandes bancos (martes) y las ventas minoristas y el PPI (jueves) completan el cuadro. El lunes con bonos cerrados puede dejar liquidez fina."},"bancos_centrales":{"fed":"<cite index=\"13-7\">Tipos en 3,75-4,00 % tras la subida del 16 de septiembre.</cite> Próxima reunión el 28 de octubre: <cite index=\"15-5\">mantener ~82 %</cite>, subida de 25 pb ~18 %. Diciembre: <cite index=\"20-2\">~71 % de subida de 25 pb</cite> (CME FedWatch).","bce":"<cite index=\"32-5\">Depósito en 2,50 %. Próxima decisión el 29 de octubre: 70 de 73 economistas esperan mantener y 64 de 73 una subida en diciembre</cite> (Reuters). No tengo una probabilidad de mercado actualizada."},"escenarios":[{"id":"CPI m/m","por_que":"Previsión 0,6 % frente a 0,4 % anterior; decide las apuestas para la Fed del 28 de octubre.","si_mayor":"Hawkish: sube el riesgo de subida en octubre. Dólar al alza, EUR/USD a la baja, rendimientos arriba; S&P y sobre todo Nasdaq cederían.","si_menor":"Dovish: el dólar cede y EUR/USD rebota hacia 1,12. Bajan los rendimientos y la tecnología respira; el S&P podría probar máximos."},{"id":"Core CPI m/m","por_que":"Mide la inflación subyacente, menos ligada a la energía, y pesa más en la Fed.","si_mayor":"Refuerza la tesis de subidas: dólar firme, EUR/USD hacia mínimos de 17 meses, índices bajo presión por los tipos.","si_menor":"Alivia el temor a una inflación extendida: dólar a la baja, EUR/USD sube, apoyo para índices tecnológicos."},{"id":"CPI y/y","por_que":"Previsión 3,6 % frente a 3,4 %; confirma o no la aceleración por energía.","si_mayor":"Dólar y rendimientos al alza; EUR/USD pierde soporte; S&P y Nasdaq se resienten con el 10 años cerca de 5,3 %.","si_menor":"Dólar más débil, EUR/USD sube; las acciones reciben alivio por menores expectativas de tipos."},{"id":"Retail Sales m/m","por_que":"Mide la fortaleza del consumo tras un mes anterior muy alto (+1,2 %).","si_mayor":"Consumo fuerte: dólar y rendimientos suben, EUR/USD baja. Bolsa dividida entre buen crecimiento y más riesgo de subida de tipos.","si_menor":"Consumo flojo: dólar cede y EUR/USD sube. Menos presión de tipos, pero algo de temor por el crecimiento."},{"id":"Core PPI m/m","por_que":"Precios de producción; anticipa presión en la inflación de consumo.","si_mayor":"Refuerza el temor inflacionista: dólar al alza, EUR/USD a la baja, tecnología presionada por los rendimientos.","si_menor":"Descarga parte del riesgo inflacionista tras el IPC: dólar más suave y apoyo moderado a S&P y Nasdaq."},{"id":"Fed Chairman Warsh Speaks","por_que":"Primera señal del presidente de la Fed sobre una posible subida; evento en Bangkok.","si_mayor":"Tono duro sobre subidas: dólar firme, EUR/USD bajista, índices vulnerables. Ocurre en horario asiático; el efecto llega a Nueva York.","si_menor":"Tono blando o de espera: dólar cede, EUR/USD rebota, rendimientos bajan y la tecnología se beneficia."}],"otros_eventos":[{"dia":"Lunes","hora":null,"texto":"Festivo en bonos EE. UU. (Columbus Day), bolsa abierta; habla Hammack (Fed)."},{"dia":"Martes","hora":"13:00","texto":"Resultados: JPMorgan, Goldman, Wells Fargo y Citi, antes de la apertura."},{"dia":"Martes","hora":"13:45","texto":"Habla Waller (Fed); también Barkin y Collins durante el día."},{"dia":"Miércoles","hora":null,"texto":"Beige Book de la Fed; resultados de Bank of America, Morgan Stanley, BlackRock y ASML."},{"dia":"Miércoles","hora":null,"texto":"Hablan Hammack (Fed) y varios del BCE (Kocher, Simkus, Pereira, Moulin)."},{"dia":"Jueves","hora":null,"texto":"Resultados de U.S. Bancorp, Schwab y TSMC; más datos de EE. UU. a las 14:30."},{"dia":"Viernes","hora":null,"texto":"Habla Nagel (BCE); IPC final de septiembre de la eurozona."}],"lectura_usd":"Sesgo alcista (+2/5) por DXY sobre MM20 y MM50 y posicionamiento en el euro; el 2A y el diferencial no aportan. El contexto lo confirma: Fed con sesgo de subida y euro en mínimos de 17 meses. Lo matiza el empleo débil y el riesgo de un IPC suave. EUR/USD (-2/5) sigue con sesgo bajista cerca de 1,116.","lectura_indices":"Sesgo alcista fuerte (+3/5) para ambos: tendencia y VIX en calma. El S&P está a un 0,2 % del máximo y puede buscar otro, pero el Nasdaq (-1,8 %) es más frágil con el 10 años en 5,24 % y dudas sobre la IA. Un IPC alto con bancos flojos arriesga un retroceso.","ventana_ny":"Martes: bancos a las 13:00 antes de la apertura (15:30). Miércoles: IPC a las 14:30 y Beige Book por la tarde. Jueves 14:30: ventas minoristas, PPI, Philly Fed y peticiones. Lunes: liquidez fina por el festivo en bonos. El viernes no hay dato en la ventana.","riesgos":["Nueva subida de rendimientos largos por demanda débil de deuda o fiscalidad.","Escalada con Irán y repunte del crudo por encima de 100 dólares.","Tensión fiscal en Francia que debilite al euro.","Dudas sobre ingresos de IA que hundan la tecnología."],"titulos_es":{"Bank Holiday":"Festivo bancario","ECB President Lagarde Speaks":"Discurso de Lagarde (BCE)","Core CPI m/m":"IPC subyacente mensual","Core CPI y/y":"IPC subyacente anual","CPI m/m":"IPC mensual","CPI y/y":"IPC anual","Core PPI m/m":"IPP subyacente mensual","Core Retail Sales m/m":"Ventas minoristas subyacentes mensual","PPI m/m":"IPP mensual","Retail Sales m/m":"Ventas minoristas mensual","Philly Fed Manufacturing Index":"Índice manufacturero de la Fed de Filadelfia","Unemployment Claims":"Peticiones de subsidio de desempleo","Fed Chairman Warsh Speaks":"Discurso del presidente de la Fed, Warsh"},"generada":"12/10 19:46"},"nota_dia":{"texto":"Warsh habló a las 05:30 y los datos no incluyen resultado ni previsión, así que no se puede saber si su intervención fue mejor o peor de lo esperado ni atribuirle ningún movimiento. En la semana, el DXY cae un 0,59 % y EUR/USD sube un 0,49 % hasta 1,1256. El S&P 500 baja un 1,0 %, el Nasdaq 100 un 4,14 % y el VIX sube un 8,2 %. El 10A cede 16,1 pb, algo que la tesis no contempla, ya que la sitúa cerca de máximos. Mañana conviene vigilar si el Nasdaq sigue presionado y si los tipos largos se mantienen a la baja antes del IPC del miércoles.","generada":"16/10 16:30","fecha":"2026-10-16"},"sesgo":{"usd":{"sujeto":"USD","puntuacion":-1,"maximo":5,"etiqueta":"Bajista","factores":[{"factor":"Tendencia DXY","voto":0,"detalle":"DXY 101.61, entre sus medias de 20 y 50 días (sin tendencia clara) (MM20 101.67 · MM50 100.32)"},{"factor":"DXY en la semana","voto":-1,"detalle":"-0.59 % desde el cierre del viernes (umbral ±0,5 %)"},{"factor":"Bono 2A EE. UU.","voto":0,"detalle":"4.719 %, -7.2 pb en la semana (umbral ±8 pb). Es el plazo que más refleja lo que espera el mercado de la Fed"},{"factor":"Diferencial 10A EE. UU.-Alemania","voto":-1,"detalle":"167 pb, -8.5 pb en la semana (umbral ±5 pb). Si se amplía, favorece al USD frente al EUR"},{"factor":"Datos USD de la semana","voto":1,"detalle":"6 mejores de lo previsto · 1 peores"}]},"spx":{"sujeto":"S&P 500","puntuacion":3,"maximo":4,"etiqueta":"Alcista fuerte","factores":[{"factor":"Tendencia","voto":1,"detalle":"7.733, por encima de sus medias de 50 y 200 días"},{"factor":"Distancia al máximo","voto":1,"detalle":"-1.1 % respecto al máximo de 5 años (7.819)"},{"factor":"VIX","voto":0,"detalle":"16.06, +8.2 % en la semana: zona intermedia"},{"factor":"Bono 10A EE. UU.","voto":1,"detalle":"5.083 %, -16.1 pb en la semana (umbral ±10 pb). Tipos al alza presionan las valoraciones, sobre todo de la tecnología"}]},"ndx":{"sujeto":"Nasdaq 100","puntuacion":1,"maximo":4,"etiqueta":"Alcista","factores":[{"factor":"Tendencia","voto":0,"detalle":"29.606, entre sus medias de 50 y 200 días"},{"factor":"Distancia al máximo","voto":0,"detalle":"-5.2 % respecto al máximo de 5 años (31.225)"},{"factor":"VIX","voto":0,"detalle":"16.06, +8.2 % en la semana: zona intermedia"},{"factor":"Bono 10A EE. UU.","voto":1,"detalle":"5.083 %, -16.1 pb en la semana (umbral ±8 pb). Tipos al alza presionan las valoraciones, sobre todo de la tecnología"}]},"eurusd":{"sujeto":"EUR/USD","puntuacion":1,"maximo":5,"etiqueta":"Alcista","factores":[]}},"semana_anterior":null,"coste":{"desde":"2026-10-12","total_usd":1.0153,"semana":"2026-10-12","semana_usd":1.0153,"llamadas":9,"ultima_ejecucion":[{"tarea":"resumen del día","modelo":"claude-haiku-5-5","entrada":1929,"salida":1183,"busquedas":0,"usd":0.0008}]},"diagnostico":[],"_control":{"coste":{"desde":"2026